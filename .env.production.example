# Configuración de producción de Planillero para VPS con Docker y Traefik.
#
# Uso en el VPS:
#   cp .env.production.example .env.production
#   ./scripts/generate-jwt-keys.sh
#   # Completá POSTGRES_PASSWORD con una contraseña segura en .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# --- Base de datos PostgreSQL ---
POSTGRES_DB=planillero_prod
POSTGRES_USER=planillero
POSTGRES_PASSWORD=cambiar-por-un-password-seguro-en-produccion

# --- Firma criptográfica de evidencias (HMAC-SHA256) ---
# El script scripts/generate-jwt-keys.sh genera un valor aleatorio de 64 caracteres hex.
HMAC_SECRET=cambiar-por-secreto-aleatorio-de-al-menos-32-caracteres

# --- Claves JWT RSA (RS256) ---
# Montadas desde ./keys:/app/keys:ro según define docker-compose.prod.yml
JWT_PRIVATE_KEY_RESOURCE=file:/app/keys/private.pem
JWT_PUBLIC_KEY_RESOURCE=file:/app/keys/public.pem

# --- Traefik y Subdominio ---
APP_DOMAIN=planillero.ferchamorro.cloud
