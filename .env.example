# Copiá este archivo a `.env` y ajustá los valores:  cp .env.example .env
# El `.env` NO se versiona (está en .gitignore).
#
# Todos los valores de acá son de ejemplo, ficticios y SÓLO para uso local. No los reutilices en
# ningún despliegue real: generá secretos propios.

# --- PostgreSQL ---
POSTGRES_DB=planillero
POSTGRES_USER=planillero
POSTGRES_PASSWORD=planillero
POSTGRES_PORT=5432

# --- MinIO (almacenamiento de objetos compatible con S3) ---
# El backend aún guarda las evidencias en disco local (STORAGE_TYPE=local); MinIO queda provisto
# con su bucket para cuando el backend lo use.
MINIO_ACCESS_KEY=planillero-local
MINIO_SECRET_KEY=planillero-local-secret
MINIO_BUCKET=evidence
# Imágenes: Docker Hub ya no publica las de MinIO; se usa quay.io con tags fijos. Podés cambiarlas.
#MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
#MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend ---
# Clave para firmar los manifiestos con HMAC-SHA256. Mínimo 32 caracteres.
HMAC_SECRET=local-only-hmac-secret-change-me-0123456789
BACKEND_PORT=8080

# --- Backoffice (NGINX) ---
WEB_PORT=8081
